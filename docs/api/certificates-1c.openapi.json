{
  "openapi": "3.1.0",
  "info": {
    "title": "Пламенея — выпуск электронных сертификатов через 1С",
    "version": "1.0.0",
    "description": "Очередь оплаченных заявок и подтверждение выпуска сертификатов в 1С."
  },
  "servers": [
    {
      "url": "https://api.dev.plameneya.com",
      "description": "DEV; подключение после публикации API и выдачи ключа."
    },
    {
      "url": "https://api.plameneya.com",
      "description": "Production; подключение после запуска интеграции."
    }
  ],
  "security": [
    {
      "ApiKey": []
    }
  ],
  "paths": {
    "/api/1c/certificates/index.php": {
      "get": {
        "operationId": "listPendingCertificateIssues",
        "summary": "Получить оплаченные заявки на выпуск",
        "description": "Только оплаченные неотменённые заявки без подтверждённого номера. При недоступности 1С заявка остаётся в выдаче. Читайте страницы до nextAfterId=null, затем новый проход с afterId=0. Пустая выдача не означает, что новые заявки больше не появятся.",
        "x-required-scopes": [
          "certificates:read"
        ],
        "parameters": [
          {
            "name": "afterId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список заявок",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingResponse"
                },
                "example": {
                  "status": 1,
                  "code": null,
                  "error": null,
                  "result": {
                    "items": [
                      {
                        "requestId": 1101,
                        "orderId": 101,
                        "amount": 5000,
                        "currency": "RUB",
                        "paid": true,
                        "buyerName": "Тестовый покупатель",
                        "buyerEmail": "buyer@example.invalid",
                        "recipientName": "Тестовый получатель",
                        "recipientEmail": "recipient@example.invalid"
                      }
                    ],
                    "nextAfterId": 1101
                  }
                }
              }
            }
          },
          "401": {
            "description": "Неверный ключ API",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "UNAUTHORIZED",
                  "error": "Неверный ключ API",
                  "result": null
                }
              }
            }
          },
          "403": {
            "description": "Недостаточно прав",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "FORBIDDEN",
                  "error": "Недостаточно прав",
                  "result": null
                }
              }
            }
          },
          "405": {
            "description": "Метод не поддерживается",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "METHOD_NOT_ALLOWED",
                  "error": "Метод не поддерживается",
                  "result": null
                }
              }
            }
          },
          "422": {
            "description": "Некорректные данные",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "VALIDATION_ERROR",
                  "error": "Некорректные данные",
                  "result": null
                }
              }
            }
          },
          "500": {
            "description": "Ошибка обработки сертификата",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "INTERNAL_ERROR",
                  "error": "Ошибка обработки сертификата",
                  "result": null
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "confirmCertificateIssued",
        "summary": "Подтвердить выпуск активного сертификата в 1С",
        "description": "В 1С использовать site identity + orderId как ключ идемпотентности и сохранять результат выпуска до callback. Повтор точно такого же номера, внешнего ID, суммы и срока успешен. Другие данные существующего сертификата или номер/ID другого заказа дают 409. HTTP 200 означает сохранение выпуска сайтом; письмо отправляется отдельно. При timeout/5xx повторять тот же callback, не выпускать второй сертификат.",
        "x-required-scopes": [
          "certificates:issue"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueRequest"
              },
              "example": {
                "orderId": 101,
                "number": "EXAMPLE-PL-000101",
                "externalId": "example-guid-from-1c",
                "amount": 5000,
                "currency": "RUB",
                "expiresOn": "2030-12-31"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Выпуск сохранён, в том числе идентичный повтор",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueResponse"
                },
                "example": {
                  "status": 1,
                  "code": null,
                  "error": null,
                  "result": {
                    "orderId": 101,
                    "accepted": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Некорректный JSON",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "BAD_JSON",
                  "error": "Некорректный JSON",
                  "result": null
                }
              }
            }
          },
          "401": {
            "description": "Неверный ключ API",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "UNAUTHORIZED",
                  "error": "Неверный ключ API",
                  "result": null
                }
              }
            }
          },
          "403": {
            "description": "Недостаточно прав",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "FORBIDDEN",
                  "error": "Недостаточно прав",
                  "result": null
                }
              }
            }
          },
          "404": {
            "description": "Заявка не найдена",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "NOT_FOUND",
                  "error": "Заявка не найдена",
                  "result": null
                }
              }
            }
          },
          "405": {
            "description": "Метод не поддерживается",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "METHOD_NOT_ALLOWED",
                  "error": "Метод не поддерживается",
                  "result": null
                }
              }
            }
          },
          "409": {
            "description": "Заказ не оплачен или отменён",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "CONFLICT",
                  "error": "Заказ не оплачен или отменён",
                  "result": null
                }
              }
            }
          },
          "413": {
            "description": "Слишком большой запрос",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "PAYLOAD_TOO_LARGE",
                  "error": "Слишком большой запрос",
                  "result": null
                }
              }
            }
          },
          "422": {
            "description": "Некорректные данные",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "VALIDATION_ERROR",
                  "error": "Некорректные данные",
                  "result": null
                }
              }
            }
          },
          "500": {
            "description": "Ошибка обработки сертификата",
            "headers": {
              "X-Certificate-Contract-Version": {
                "schema": {
                  "type": "string",
                  "const": "1.0.0"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "code": "INTERNAL_ERROR",
                  "error": "Ошибка обработки сертификата",
                  "result": null
                }
              }
            }
          }
        }
      },
      "options": {
        "operationId": "certificateExchangeOptions",
        "summary": "Проверить разрешённые методы",
        "security": [],
        "responses": {
          "204": {
            "description": "GET, POST, OPTIONS; тела ответа нет"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "Серверный ключ согласованного клиента 1С. Scopes certificates:read и certificates:issue выдаются явно в реестре клиентов. Пользовательский JWT не подходит."
      }
    },
    "schemas": {
      "PendingItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "orderId",
          "amount",
          "currency",
          "paid",
          "buyerName",
          "buyerEmail",
          "recipientName",
          "recipientEmail"
        ],
        "properties": {
          "requestId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "orderId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "amount": {
            "type": "integer",
            "minimum": 1000
          },
          "currency": {
            "const": "RUB",
            "type": "string"
          },
          "paid": {
            "const": true,
            "type": "boolean"
          },
          "buyerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "buyerEmail": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
          },
          "recipientName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "recipientEmail": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
          }
        }
      },
      "IssueRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orderId",
          "number",
          "externalId",
          "amount",
          "currency"
        ],
        "properties": {
          "orderId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?=.*\\S)[^\\x00-\\x1F\\x7F]+$"
          },
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?=.*\\S)[^\\x00-\\x1F\\x7F]+$"
          },
          "amount": {
            "type": "integer",
            "minimum": 1000
          },
          "currency": {
            "const": "RUB",
            "type": "string"
          },
          "expiresOn": {
            "type": "string",
            "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$",
            "description": "Дата окончания по правилам 1С. Пустая строка или отсутствие поля означает, что дата не передана. Формат и календарная дата проверяются сервером."
          }
        }
      },
      "PendingResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "code",
          "error",
          "result"
        ],
        "properties": {
          "status": {
            "const": 1,
            "type": "integer"
          },
          "code": {
            "type": "null"
          },
          "error": {
            "type": "null"
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "items",
              "nextAfterId"
            ],
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "$ref": "#/components/schemas/PendingItem"
                }
              },
              "nextAfterId": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "description": "Курсор только в рамках текущего прохода. Новый цикл начинать с afterId=0."
              }
            }
          }
        }
      },
      "IssueResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "code",
          "error",
          "result"
        ],
        "properties": {
          "status": {
            "const": 1,
            "type": "integer"
          },
          "code": {
            "type": "null"
          },
          "error": {
            "type": "null"
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "orderId",
              "accepted"
            ],
            "properties": {
              "orderId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "accepted": {
                "const": true,
                "type": "boolean"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "code",
          "error",
          "result"
        ],
        "properties": {
          "status": {
            "const": 0,
            "type": "integer"
          },
          "code": {
            "type": "string",
            "enum": [
              "BAD_JSON",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "VALIDATION_ERROR",
              "INTERNAL_ERROR"
            ]
          },
          "error": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "null"
          }
        }
      }
    }
  }
}
